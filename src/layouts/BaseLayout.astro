---
import '@/styles/global.css';
import Navbar from '@/components/Navbar/Navbar.astro';
import Footer from '@/components/Footer/Footer.astro';
import BackToTop from '@/components/UI/BackToTop';
import FloatingShapes from '@/components/UI/FloatingShapes.astro';
import { profile } from '@/data/profile';
import { contact, socialLinks } from '@/data/profile';

interface Props {
  title?: string;
  description?: string;
  document?: boolean;
}

const {
  title = `${profile.name} | ${profile.role}`,
  description = profile.bio,
  document = false,
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? 'https://jensenmanalo.dev';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: contact.email,
  url: siteUrl,
  sameAs: socialLinks.filter((l) => !l.url.startsWith('mailto')).map((l) => l.url),
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/og-image.svg`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://formspree.io" />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class:list={['relative min-h-screen overflow-x-hidden antialiased', document && 'document-page']}>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    {!document && <FloatingShapes />}
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <BackToTop client:idle />
  </body>
</html>

<script is:inline>
  (function () {
    const stored = localStorage.getItem('theme');
    if (stored) {
      document.documentElement.setAttribute('data-theme', stored);
    }
  })();
</script>
