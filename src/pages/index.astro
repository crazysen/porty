---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Hero from "../components/Hero.astro";
import Skills from "../components/Skills";
import Projects from "../components/Projects";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Certifications from "../components/Certifications";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import SectionHeading from "../components/SectionHeading.astro";

const orbs = [
  { position: "top-[16%] -left-48", size: "size-[34rem]", color: "bg-blue-600/20", factor: "0.25" },
  { position: "top-[38%] -right-48", size: "size-[30rem]", color: "bg-cyan-500/15", factor: "-0.2" },
  { position: "top-[60%] left-[20%]", size: "size-[32rem]", color: "bg-indigo-600/15", factor: "0.3" },
  { position: "top-[82%] right-[15%]", size: "size-[26rem]", color: "bg-sky-500/15", factor: "-0.15" },
];
---

<Layout>
  <Navbar client:load />
  <main class="relative isolate">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      {
        orbs.map((orb) => (
          <div data-parallax={orb.factor} class={`absolute ${orb.position} ${orb.size} rounded-full ${orb.color} blur-3xl`} />
        ))
      }
    </div>

    <Hero />

    <div class="border-y border-line bg-navy/60">
      <About />
    </div>

    <section id="skills" class="px-4 py-20 sm:px-6 sm:py-28">
      <div class="mx-auto max-w-6xl">
        <SectionHeading
          kicker="tech stack"
          title="Tech Stack & Skills"
          lead="The languages, frameworks, and tools I use to design and ship web and mobile apps."
          class="mb-10"
        />
        <Skills client:load />
      </div>
    </section>

    <section id="projects" class="border-y border-line bg-navy/60 px-4 py-20 sm:px-6 sm:py-28">
      <div class="mx-auto max-w-6xl">
        <SectionHeading
          kicker="projects"
          title="Featured Projects"
          lead="A selection of my recent work. Click a project to see its highlights and tech."
          class="mb-10"
        />
        <Projects client:load />
      </div>
    </section>

    <Experience />

    <section id="certifications" class="border-y border-line bg-navy/60 px-4 py-20 sm:px-6 sm:py-28">
      <div class="mx-auto max-w-6xl">
        <SectionHeading
          kicker="certifications"
          title="Certifications"
          lead="Swipe, drag, or use the arrows to explore my certifications."
          class="mb-8"
        />
        <div data-reveal="zoom">
          <Certifications client:load />
        </div>
      </div>
    </section>

    <Contact />
  </main>
  <Footer />
</Layout>
