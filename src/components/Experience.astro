---
import { Briefcase, MapPin } from "lucide-react";
import SectionHeading from "./SectionHeading.astro";
import { experience } from "../data/experience";
---

<section id="experience" class="px-4 py-20 sm:px-6 sm:py-28">
  <div class="mx-auto max-w-4xl">
    <SectionHeading kicker="experience" title="Work Experience" class="mb-12" />

    <div data-timeline class="relative pl-8 sm:pl-10">
      <span aria-hidden="true" class="absolute inset-y-0 left-0 w-px bg-line"></span>
      <span
        aria-hidden="true"
        class="timeline-fill absolute inset-y-0 left-0 w-px origin-top bg-linear-to-b from-blue-400 via-sky-400 to-cyan-300 shadow-[0_0_10px_rgb(56_189_248/0.8)]"
      >
      </span>
      <ol class="space-y-8">
      {
        experience.map((job, i) => (
          <li data-reveal={i % 2 === 0 ? "right" : "left"} class="relative">
            <span class="timeline-dot absolute top-6 -left-[2.95rem] grid size-8 place-items-center rounded-full border border-blue-400/40 bg-navy text-cyan-300 shadow-[0_0_20px_-4px_rgb(59_130_246/0.7)] sm:-left-[3.45rem]">
              <Briefcase size={14} />
            </span>
            <article class="panel panel-hover p-6 sm:p-7">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h3 class="text-lg font-semibold">{job.role}</h3>
                  <p class="text-cyan-300/90">{job.organization}</p>
                </div>
                <span class="chip">{job.period}</span>
              </div>
              <p class="mt-2 inline-flex items-center gap-1.5 text-sm text-ink-soft">
                <MapPin size={14} /> {job.location}
              </p>
              <ul class="mt-4 list-disc space-y-1.5 pl-5 text-ink-soft marker:text-blue-400">
                {job.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>
