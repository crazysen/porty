---
import SectionHeading from '@/components/UI/SectionHeading.astro';
import Card from '@/components/UI/Card.astro';
import { experiences } from '@/data/experience';
import { Icon } from 'astro-icon/components';

const typeIcons: Record<string, string> = {
  internship: 'lucide:briefcase',
  ojt: 'lucide:graduation-cap',
  freelance: 'lucide:laptop',
  volunteer: 'lucide:heart-handshake',
  leadership: 'lucide:users',
};

const typeLabels: Record<string, string> = {
  internship: 'Internship',
  ojt: 'OJT',
  freelance: 'Freelance',
  volunteer: 'Volunteer',
  leadership: 'Leadership',
};
---

<section id="experience" class="relative section-padding bg-[var(--bg-secondary)]">
  <div class="section-container">
    <SectionHeading
      title="Experience"
      subtitle="Internships, training, freelance work, and leadership roles"
    />

    <div class="relative mx-auto max-w-3xl">
      <div class="absolute top-0 bottom-0 left-6 w-px bg-gradient-to-b from-accent-blue via-accent-purple to-accent-cyan opacity-20 sm:left-8"></div>

      <div class="space-y-8">
        {
          experiences.map((exp) => (
            <div class="relative flex gap-6 sm:gap-8">
              <div class="relative z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-r from-accent-blue to-accent-purple sm:h-16 sm:w-16">
                <Icon name={typeIcons[exp.type]} class="h-5 w-5 text-white sm:h-6 sm:w-6" />
              </div>

              <Card class="flex-1" hover>
                <div class="flex flex-wrap items-start justify-between gap-2">
                  <div>
                    <span class="text-xs font-medium uppercase tracking-wide text-accent-cyan">
                      {typeLabels[exp.type]}
                    </span>
                    <h3 class="mt-1 text-lg font-semibold">{exp.title}</h3>
                    <p class="text-sm font-medium text-[var(--text-secondary)]">
                      {exp.organization} · {exp.location}
                    </p>
                  </div>
                  <span class="shrink-0 rounded-full border border-[var(--glass-border)] px-3 py-1 text-xs text-[var(--text-muted)]">
                    {exp.startDate} — {exp.endDate}
                  </span>
                </div>
                <p class="mt-3 text-sm text-[var(--text-secondary)]">{exp.description}</p>
                <ul class="mt-4 space-y-2">
                  {exp.achievements.map((achievement) => (
                    <li class="flex items-start gap-2 text-sm text-[var(--text-muted)]">
                      <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-accent-cyan" />
                      {achievement}
                    </li>
                  ))}
                </ul>
              </Card>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
