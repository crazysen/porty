---
interface Props {
  title: string;
  subtitle?: string;
  id?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, id, align = 'center' } = Astro.props;
const alignClass = align === 'center' ? 'text-center' : 'text-left';
---

<div class={`mb-12 ${alignClass}`} id={id}>
  <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
    <span class="gradient-text">{title}</span>
  </h2>
  {
    subtitle && (
      <p class="mt-3 text-base text-[var(--text-secondary)] sm:text-lg">{subtitle}</p>
    )
  }
  <div
    class={`mt-4 h-1 w-16 rounded-full bg-gradient-to-r from-accent-blue to-accent-purple ${align === 'center' ? 'mx-auto' : ''}`}
  >
  </div>
</div>
