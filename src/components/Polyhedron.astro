---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const outer = [
  [60, 10],
  [103.3, 35],
  [103.3, 85],
  [60, 110],
  [16.7, 85],
  [16.7, 35],
];
const inner = [
  [60, 31],
  [85.1, 74.5],
  [34.9, 74.5],
];
const spokes = [
  [0, 0], [0, 1], [0, 5],
  [1, 1], [1, 2], [1, 3],
  [2, 3], [2, 4], [2, 5],
];
---

<svg viewBox="0 0 120 120" fill="none" aria-hidden="true" class={className}>
  <g stroke="currentColor" stroke-width="0.8" stroke-linejoin="round">
    <polygon points={outer.map((p) => p.join(",")).join(" ")} />
    <polygon points={inner.map((p) => p.join(",")).join(" ")} />
    {spokes.map(([i, o]) => <line x1={inner[i][0]} y1={inner[i][1]} x2={outer[o][0]} y2={outer[o][1]} />)}
  </g>
  <g fill="currentColor">
    {[...outer, ...inner].map(([x, y]) => <circle cx={x} cy={y} r="1.6" />)}
  </g>
</svg>
