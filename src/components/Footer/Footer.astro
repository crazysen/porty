---
import { profile, socialLinks } from '@/data/profile';
import { footerLinks } from '@/data/navigation';
import { Icon } from 'astro-icon/components';
---

<footer class="relative border-t border-[var(--glass-border)] bg-[var(--bg-secondary)]">
  <div class="section-padding !py-12">
    <div class="section-container">
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Brand -->
        <div>
          <h3 class="text-lg font-bold">
            <span class="gradient-text">{profile.name}</span>
          </h3>
          <p class="mt-2 text-sm text-[var(--text-secondary)]">{profile.role}</p>
          <p class="mt-3 text-sm text-[var(--text-muted)]">{profile.tagline}</p>
        </div>

        <!-- Quick links -->
        <div>
          <h4 class="mb-4 text-sm font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
            Quick Links
          </h4>
          <ul class="flex flex-col gap-2">
            {
              footerLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-[var(--text-muted)] transition-colors hover:text-accent-cyan"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Social -->
        <div>
          <h4 class="mb-4 text-sm font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
            Connect
          </h4>
          <div class="flex gap-3">
            {
              socialLinks.map((link) => (
                <a
                  href={link.url}
                  target={link.url.startsWith('mailto') ? undefined : '_blank'}
                  rel={link.url.startsWith('mailto') ? undefined : 'noopener noreferrer'}
                  class="focus-ring flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--glass-border)] text-[var(--text-secondary)] transition-all hover:border-accent-purple/50 hover:text-accent-cyan hover:shadow-lg hover:shadow-accent-purple/10"
                  aria-label={link.name}
                >
                  <Icon name={link.icon} class="h-5 w-5" />
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-[var(--glass-border)] pt-8 sm:flex-row">
        <p class="text-sm text-[var(--text-muted)]">
          &copy; {new Date().getFullYear()} {profile.name}. All rights reserved.
        </p>
        <p class="text-sm text-[var(--text-muted)]">
          Built with Astro, React & Tailwind CSS
        </p>
      </div>
    </div>
  </div>
</footer>
