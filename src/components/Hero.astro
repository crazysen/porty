---
import { ArrowRight, MapPin, Terminal as TerminalIcon } from "lucide-react";
import StarField from "./StarField";
import Terminal from "./Terminal";
import Polyhedron from "./Polyhedron.astro";
import { GithubIcon, LinkedinIcon } from "./icons/BrandIcons";
import { profile } from "../data/profile";
---

<section id="top" class="relative overflow-hidden px-4 pt-32 pb-24 sm:px-6 sm:pt-40 sm:pb-32">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgb(30_58_138/0.55),transparent_60%)]"></div>
  <div class="grid-bg absolute inset-0 [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)]"></div>
  <StarField client:load />

  <div class="pointer-events-none absolute top-28 left-[42%] hidden text-blue-300/40 lg:block">
    <div class="animate-float">
      <Polyhedron class="animate-spin-slow size-32" />
    </div>
  </div>
  <div class="pointer-events-none absolute top-[58%] left-[52%] hidden text-cyan-300/30 lg:block">
    <div class="animate-float-slow">
      <Polyhedron class="animate-spin-slow size-20 [animation-direction:reverse]" />
    </div>
  </div>
  <div class="pointer-events-none absolute -bottom-6 left-6 text-blue-300/25 sm:left-16">
    <div class="animate-float-slow">
      <Polyhedron class="animate-spin-slow size-24" />
    </div>
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-[1.1fr_1fr]">
    <div data-reveal>
      <p class="mb-6 inline-flex items-center gap-2 rounded-lg border border-line bg-white/5 px-3 py-1.5 font-mono text-xs text-slate-300">
        <TerminalIcon size={14} className="text-cyan-300" />
        {profile.role}
        <span class="relative ml-1 flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-emerald-400"></span>
        </span>
      </p>

      <h1 class="text-4xl leading-[1.1] font-bold sm:text-5xl lg:text-6xl">
        Hi, I'm {profile.firstName}.
        <span class="text-gradient block">I build web & mobile apps.</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
        {profile.tagline}. I'm a BS Information Technology student focused on
        <span class="text-slate-200"> {profile.focus.join(", ")}</span>, turning ideas into apps people enjoy using.
      </p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {profile.heroStack.map((tech) => <li class="chip">{tech}</li>)}
      </ul>

      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#contact" class="btn btn-primary group">
          Let's work together <ArrowRight size={16} className="transition-transform group-hover:translate-x-1" />
        </a>
        <a href="#projects" class="btn btn-secondary">View my work</a>
      </div>

      <div class="mt-8 flex items-center gap-3">
        <a href={profile.github} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="GitHub profile">
          <GithubIcon size={18} />
        </a>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="LinkedIn profile">
          <LinkedinIcon size={18} />
        </a>
        <span class="ml-2 inline-flex items-center gap-1.5 text-sm text-ink-soft">
          <MapPin size={15} /> {profile.location}
        </span>
      </div>
    </div>

    <div data-reveal class="relative">
      <div class="absolute -inset-6 rounded-[2rem] bg-linear-to-tr from-blue-600/25 via-transparent to-cyan-400/20 blur-2xl"></div>
      <div class="relative">
        <Terminal client:load />
      </div>
    </div>
  </div>
</section>
